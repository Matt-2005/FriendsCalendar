# Copie ce fichier en .env (ou configure ces variables chez l'hébergeur).
# Ne mets JAMAIS de vraies valeurs dans ce fichier : il est publié sur GitHub.

# Base PostgreSQL (Prisma)
DATABASE_URL=postgresql://user:password@host:5432/db

# Sessions (next-auth) — générer avec : openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://calendar.matthewle.fr

# Photos de profil (https://console.cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Notifications push — générer avec : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://calendar.matthewle.fr

# Protège la tâche quotidienne /api/cron/reminders — générer avec : openssl rand -hex 24
CRON_SECRET=

# Connexion Google (facultatif : le bouton est masqué si absent)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facultatif : forcer un thème de saison (halloween, noel, nouvel-an, ete, none)
# SEASON_OVERRIDE=
