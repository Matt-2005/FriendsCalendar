{
  "name": "les-indecis-agenda",
  "version": "1.0.0",
  "private": true,
  "description": "Agenda partagé du groupe Les Indécis : sorties, réponses et dispos.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:db": "bash scripts/dev-db.sh",
    "dev:reset": "bash scripts/dev-db.sh reset",
    "dev:stop": "bash scripts/dev-db.sh stop",
    "build": "bash scripts/build.sh",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "ical-generator": "^9.0.0",
    "next": "^15.5.9",
    "next-auth": "^4.24.13",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-easy-crop": "^5.5.7",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "prisma": "6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
